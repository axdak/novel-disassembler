{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "轻量格式提示，仅用于任务包内引导 Agent 输出顶层结构。集合内详情字段、引用、章节/时间、控制标签等强校验以 scripts/validate_delta.py（规则源 scripts/story_schema_rules.py）为准。",
  "type": "object",
  "properties": {
    "章节范围": { "type": "string" },
    "合并重复元素": { "type": "array" },
    "降级元素": { "type": "array" },
    "补充关系": { "type": "array" },
    "修正伏笔": { "type": "array" },
    "修正事件粒度": { "type": "array" },
    "补充缺失元素": { "type": "array" },
    "待人工确认": { "type": "array" },
    "新增元素": { "type": "object" },
    "修改元素": { "type": "object" }
  },
  "required": ["章节范围", "新增元素", "修改元素"]
}
